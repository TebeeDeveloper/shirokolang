package main

import {
    "std/fmt"
}

struct Token {
    kind  string
    value string
    line  int
    col   int
}

struct Lexer {
    src  string
    pos  int
    line int
    col  int
    toks []Token
}

// ---------- character helpers ----------

func (Lexer) peek() byte {
    if self.pos >= len(self.src) {
        return 0
    }
    return self.src[self.pos]
}

func (Lexer) advance() byte {
    let c = self.peek()
    if c == 0 {
        return 0
    }
    self.pos = self.pos + 1
    self.col = self.col + 1
    return c
}

func (Lexer) isDigit(c byte) bool {
    return c >= '0' && c <= '9'
}

func (Lexer) isAlpha(c byte) bool {
    return (c >= 'a' && c <= 'z')
        || (c >= 'A' && c <= 'Z')
        || c == '_'
}

func (Lexer) isSpace(c byte) bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// ---------- token emission ----------

func (Lexer) push(kind string, value string, line int, col int) {
    let t = Token{kind: kind, value: value, line: line, col: col}
    self.toks = append(self.toks, t)
}

// ---------- scanners ----------

func (Lexer) scanNumber() string {
    let start = self.pos
    for self.peek() != 0 && self.isDigit(self.peek()) {
        self.advance()
    }
    return self.src[start:self.pos]
}

func (Lexer) scanIdent() string {
    let start = self.pos
    for self.peek() != 0 && (self.isAlpha(self.peek()) || self.isDigit(self.peek())) {
        self.advance()
    }
    return self.src[start:self.pos]
}

// ---------- main loop ----------

func (Lexer) run() []Token {
    for self.pos < len(self.src) {
        let c = self.peek()

        if c == '\n' {
            self.pos = self.pos + 1
            self.line = self.line + 1
            self.col = 1
        } else if self.isSpace(c) {
            self.advance()
        } else if self.isDigit(c) {
            let startLine = self.line
            let startCol = self.col
            let n = self.scanNumber()
            self.push("INT", n, startLine, startCol)
        } else if self.isAlpha(c) {
            let startLine = self.line
            let startCol = self.col
            let w = self.scanIdent()
            self.push("IDENT", w, startLine, startCol)
        } else {
            let startLine = self.line
            let startCol = self.col
            let ch = self.advance()
            self.push(string(ch), string(ch), startLine, startCol)
        }
    }
    return self.toks
}

// ---------- entry point ----------

func main() {
    let src = "let x = 1 + 2"
    let lx = Lexer{src: src, pos: 0, line: 1, col: 1, toks: []Token{}}
    let toks = lx.run()

    for t = iter toks {
        fmt.printf("%s: %s\n", t.kind, t.value)
    }
}


